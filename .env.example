# AeroDesk Configuration Example (.env)
# Copy this file to .env and adjust values for your environment.

# Signaling Server Port
PORT=7070

# Signaling Server WebSocket URL (used by client)
VITE_SIGNALING_URL=ws://localhost:7070

# Public STUN Servers (comma-separated)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN Relay Server (for strict NAT / symmetric firewall traversal)
# TURN_SERVER_URL=turn:turn.yourdomain.com:3478
# TURN_USERNAME=aerodesk_user
# TURN_CREDENTIAL=your_turn_secret_token

# Security Settings
ALLOW_UNATTENDED_ACCESS=true
REQUIRE_CONSENT_DEFAULT=true

# Environment
NODE_ENV=production
